#! /usr/bin/env sh
# Runs the tests every time a file is modified
# Displays a timer showing how long ago the test-suite last ran
#
# Doesn't react on files being deleted


if ! [ "$#" -gt 0 ]; then
	echo "Run with command and file pattern"
	echo "Example:"
	echo "\"auto-repeat 'cargo test' '*.rs'\""
	echo ""
	echo "To test file pattern run:"
	echo "find . -iname pattern"
	exit
fi

timestamp_file='.auto-run-mark'

touch -d "1970-01-01 00:00:00" $timestamp_file
display-timer &
timer_pid=$!

function cleanup {
	rm $timestamp_file
	kill $timer_pid
}
trap cleanup EXIT

while true; do
	changes=$(find . -iname "$2" -cnewer $timestamp_file | wc -l)
	if [ ! "$changes" = "0" ]; then
		touch $timestamp_file
		kill $timer_pid
		clear -x
		eval "$1"
		echo
		display-timer &
		timer_pid=$!
	fi

	sleep 0.1
done;
